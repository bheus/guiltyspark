LOKI_URL=http://loki:3100
LOKI_QUERY='{job=~".+"}'
LOKI_LIMIT=5000

CODEX_HOME=/data/codex
GUILTYSPARK_INTERVAL_SECONDS=300
GUILTYSPARK_LOOKBACK_SECONDS=900
GUILTYSPARK_STATE_PATH=/data/guiltyspark.sqlite3
GUILTYSPARK_FINDINGS_PATH=/data/findings.jsonl
GUILTYSPARK_RUNBOOK_PATH=/app/knowledge/runbook.md
GUILTYSPARK_NOTIFY_WEBHOOK_URL=
# Email a Monitor-voiced alert via Resend whenever guiltyspark opens a PR.
# Only fires for guiltyspark's own PRs, never ones you open yourself.
RESEND_API_KEY=
GUILTYSPARK_NOTIFY_EMAIL_FROM=
GUILTYSPARK_NOTIFY_EMAIL_TO=
GUILTYSPARK_MIN_EVENTS=2
GUILTYSPARK_MAX_INCIDENTS_PER_RUN=8
GUILTYSPARK_MODEL=
GUILTYSPARK_ANALYSIS_MODEL=
GUILTYSPARK_REMEDIATION_MODEL=gpt-5.6-luna

GUILTYSPARK_CODEX_PATH=codex
GUILTYSPARK_CODEX_WORKDIR=/app
GUILTYSPARK_CODEX_TIMEOUT_SECONDS=600
GUILTYSPARK_PR_MODE=off

# Multi-target remediation. Copy targets.example.toml to a persistent config path.
GUILTYSPARK_TARGETS_PATH=
GUILTYSPARK_TARGETS_JSON=
GUILTYSPARK_REMEDIATION_ROOT=/data/remediation
GUILTYSPARK_GITHUB_TOKEN_ENV=GITHUB_TOKEN
GITHUB_TOKEN=
