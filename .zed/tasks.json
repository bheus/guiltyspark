[
  {
    "label": "uv: sync dev",
    "command": "uv",
    "args": ["sync", "--dev", "--no-editable"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "hide": "on_success"
  },
  {
    "label": "uv: test",
    "command": "uv",
    "args": ["run", "--no-editable", "pytest"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "hide": "on_success"
  },
  {
    "label": "guiltyspark: doctor local",
    "command": "uv",
    "args": [
      "run",
      "--no-editable",
      "--reinstall-package",
      "guiltyspark",
      "guiltyspark",
      "doctor"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "env": {
      "GUILTYSPARK_STATE_PATH": "data/local.sqlite3",
      "GUILTYSPARK_FINDINGS_PATH": "data/local-findings.jsonl",
      "GUILTYSPARK_RUNBOOK_PATH": "knowledge/homelab-runbook.md",
      "GUILTYSPARK_CODEX_WORKDIR": "$ZED_WORKTREE_ROOT",
      "CODEX_HOME": "data/codex"
    },
    "reveal": "always"
  },
  {
    "label": "guiltyspark: once local",
    "command": "uv",
    "args": [
      "run",
      "--no-editable",
      "--reinstall-package",
      "guiltyspark",
      "guiltyspark",
      "once"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "env": {
      "GUILTYSPARK_STATE_PATH": "data/local.sqlite3",
      "GUILTYSPARK_FINDINGS_PATH": "data/local-findings.jsonl",
      "GUILTYSPARK_RUNBOOK_PATH": "knowledge/homelab-runbook.md",
      "GUILTYSPARK_CODEX_WORKDIR": "$ZED_WORKTREE_ROOT",
      "CODEX_HOME": "data/codex"
    },
    "reveal": "always"
  }
]
